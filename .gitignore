# Create .gitignore in the root directory
@"
# Dependencies
node_modules/
frontend/node_modules/
vanna-ai/__pycache__/
vanna-ai/.venv/
vanna-ai/venv/

# Environment variables
.env
.env.local
.env*.local
frontend/.env
frontend/.env.local
vanna-ai/.env

# Build outputs
frontend/.next/
frontend/out/
frontend/build/
dist/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Python
*.pyc
*.pyo
*.pyd
__pycache__/
*.so
*.egg
*.egg-info/

# Logs
*.log
logs/

# Database
*.db
*.sqlite
*.sqlite3
"@ | Out-File -FilePath .gitignore -Encoding utf8